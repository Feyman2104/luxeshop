rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Registro global de sesiones:
    // - Cualquier usuario autenticado puede LEER todas las sesiones
    //   (el dashboard muestra "Actividad en tiempo real de todos los usuarios").
    // - Solo puede CREAR sesiones cuyo uid coincida con el suyo.
    // - Solo puede ACTUALIZAR (cerrar) sesiones que él mismo abrió.
    match /sessions/{sessionId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Cada usuario solo puede leer/escribir su propio perfil.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
